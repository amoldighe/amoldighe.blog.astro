  }
</style>

<script>
  (() => {
    function initBoeCalculator() {
      const container = document.querySelector('.boe-container');
      if (!container) return;

      const dauInput = document.getElementById('boe-dau') as HTMLInputElement | null;
      const actionsInput = document.getElementById('boe-actions') as HTMLInputElement | null;
      const payloadInput = document.getElementById('boe-payload') as HTMLInputElement | null;
      const ratioSelect = document.getElementById('boe-ratio') as HTMLSelectElement | null;
      const replSelect = document.getElementById('boe-replication') as HTMLSelectElement | null;

      const copyLinkBtn = document.getElementById('boe-copy-link');
      const copyMdBtn = document.getElementById('boe-copy-markdown');
      const resetBtn = document.getElementById('boe-reset');

      if (!dauInput || !actionsInput || !payloadInput || !ratioSelect || !replSelect) {
        return;
      }

      // Explicit non-null elements for strict TypeScript narrowing
      const dauEl = dauInput;
      const actionsEl = actionsInput;
      const payloadEl = payloadInput;
      const ratioEl = ratioSelect;
      const replEl = replSelect;

      const presets: Record<string, { dau: number; actions: number; kb: number; ratio: number; repl: number }> = {
        twitter: { dau: 250, actions: 2, kb: 1, ratio: 100, repl: 3 },
        urlshortener: { dau: 100, actions: 1, kb: 0.5, ratio: 100, repl: 3 },
        chatapp: { dau: 50, actions: 40, kb: 2, ratio: 10, repl: 3 },
        videometa: { dau: 100, actions: 0.2, kb: 5, ratio: 1000, repl: 3 },
        iotlog: { dau: 10, actions: 100, kb: 1, ratio: 1, repl: 2 }
      };

      function roundNum(e: number): string {
        if (e >= 100) {
          return Math.round(e).toLocaleString("en-US");
        } else if (e >= 10) {
          return e.toFixed(1);
        } else {
          return e.toFixed(2).replace(/\.?0+$/, "") || "0";
        }
      }

      function formatRate(e: number): string {
        if (e >= 1e9) return `${roundNum(e / 1e9)}B`;
        if (e >= 1e6) return `${roundNum(e / 1e6)}M`;
        if (e >= 1e3) return `${roundNum(e / 1e3)}K`;
        return roundNum(e);
      }

      function formatBytes(bytes: number): string {
        const units = ["KB", "MB", "GB", "TB", "PB"];
        let val = bytes / 1024;
        let unitIdx = 0;
        while (val >= 1024 && unitIdx < units.length - 1) {
          val /= 1024;
          unitIdx++;
        }
        return `${roundNum(val)} ${units[unitIdx]}`;
      }

      function calculate() {
        const dauMillions = Math.max(parseFloat(dauEl.value) || 0, 0);
        const actionsPerDay = Math.max(parseFloat(actionsEl.value) || 0, 0);
        const payloadKb = Math.max(parseFloat(payloadEl.value) || 0, 0);
        const readWriteRatio = Math.max(parseFloat(ratioEl.value) || 1, 1);
        const replication = Math.max(parseInt(replEl.value, 10) || 1, 1);

        const totalUsers = dauMillions * 1e6;
        const totalWritesDay = totalUsers * actionsPerDay;
        const writeQps = totalWritesDay / 86400;
        const peakWriteQps = 3 * writeQps;
        const readQps = writeQps * readWriteRatio;
        const peakReadQps = 3 * readQps;

        const payloadBytes = payloadKb * 1024;
        const dailyStorageBytes = totalWritesDay * payloadBytes;
        const yearlyStorageBytes = 365 * dailyStorageBytes;
        const replicatedStorageBytes = yearlyStorageBytes * replication;

        const ingressBytesSec = writeQps * payloadBytes;
        const egressBytesSec = readQps * payloadBytes;
        const dailyReadVolumeBytes = 86400 * readQps * payloadBytes;
        const cacheBytes = 0.20 * dailyReadVolumeBytes;

        setText('boe-pipe-dau', `${roundNum(dauMillions)}M`);
        setText('boe-pipe-writes-label', `× ${roundNum(actionsPerDay)} writes/day`);
        setText('boe-pipe-writes', formatRate(totalWritesDay));
        setText('boe-pipe-write-qps', formatRate(writeQps));
        setText('boe-pipe-read-label', `× ${readWriteRatio} read QPS`);
        setText('boe-pipe-read-qps', formatRate(readQps));
        setText('boe-pipe-peak-qps', formatRate(peakReadQps));

        setText('boe-val-avg-write-qps', formatRate(writeQps));
        setText('boe-form-avg-write-qps', `= ${roundNum(dauMillions)}M DAU × ${roundNum(actionsPerDay)} writes / 86,400s`);
        setText('boe-val-peak-write-qps', formatRate(peakWriteQps));
        setText('boe-form-peak-write-qps', `= avg × 3 (peak factor)`);
        setText('boe-val-avg-read-qps', formatRate(readQps));
        setText('boe-form-avg-read-qps', `= write QPS × ${readWriteRatio} (read:write ratio)`);
        setText('boe-val-peak-read-qps', formatRate(peakReadQps));
        setText('boe-form-peak-read-qps', `= read QPS × 3 (peak factor)`);

        setText('boe-val-data-day', formatBytes(dailyStorageBytes));
        setText('boe-form-data-day', `= ${formatRate(totalWritesDay)} writes × ${roundNum(payloadKb)} KB`);
        setText('boe-val-data-year', formatBytes(yearlyStorageBytes));
        setText('boe-form-data-year', `= daily volume × 365`);
        setText('boe-label-replication', `Stored with ${replication}x replication`);
        setText('boe-val-data-replicated', formatBytes(replicatedStorageBytes));
        setText('boe-form-data-replicated', `= yearly volume × ${replication} replicas`);

        setText('boe-val-ingress', `${formatBytes(ingressBytesSec)}/s`);
        setText('boe-form-ingress', `= write QPS × ${roundNum(payloadKb)} KB`);
        setText('boe-val-egress', `${formatBytes(egressBytesSec)}/s`);
        setText('boe-form-egress', `= read QPS × ${roundNum(payloadKb)} KB`);
        setText('boe-val-cache', formatBytes(cacheBytes));
        setText('boe-form-cache', `= 20% of daily read volume (80/20 rule)`);
      }

      function setText(id: string, text: string) {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      }

      [dauEl, actionsEl, payloadEl].forEach(inp => inp.addEventListener('input', calculate));
      [ratioEl, replEl].forEach(sel => sel.addEventListener('change', calculate));

      document.querySelectorAll('.boe-preset-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const key = target.dataset.preset;
          if (key && presets[key]) {
            const p = presets[key];
            dauEl.value = p.dau.toString();
            actionsEl.value = p.actions.toString();
            payloadEl.value = p.kb.toString();
            ratioEl.value = p.ratio.toString();
            replEl.value = p.repl.toString();
            calculate();
          }
        });
      });

      const params = new URLSearchParams(window.location.search);
      if (params.has('dau')) dauEl.value = params.get('dau')!;
      if (params.has('actions')) actionsEl.value = params.get('actions')!;
      if (params.has('kb')) payloadEl.value = params.get('kb')!;
      if (params.has('ratio')) ratioEl.value = params.get('ratio')!;
      if (params.has('repl')) replEl.value = params.get('repl')!;

      copyLinkBtn?.addEventListener('click', async () => {
        const url = new URL(window.location.href);
        url.searchParams.set('dau', dauEl.value);
        url.searchParams.set('actions', actionsEl.value);
        url.searchParams.set('kb', payloadEl.value);
        url.searchParams.set('ratio', ratioEl.value);
        url.searchParams.set('repl', replEl.value);
        const fullUrl = url.toString();
        const copyTextEl = document.getElementById('boe-copy-text');
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(fullUrl);
          } else {
            window.prompt('Copy link:', fullUrl);
          }
          if (copyTextEl) {
            const prev = copyTextEl.textContent;
            copyTextEl.textContent = 'Link copied!';
            setTimeout(() => { copyTextEl.textContent = prev; }, 2000);
          }
        } catch {
          window.prompt('Copy link:', fullUrl);
        }
      });

      copyMdBtn?.addEventListener('click', async () => {
        const dau = dauEl.value;
        const actions = actionsEl.value;
        const kb = payloadEl.value;
        const ratio = ratioEl.value;
        const repl = replEl.value;
        const writeQps = document.getElementById('boe-val-avg-write-qps')?.textContent || '';
        const peakWrite = document.getElementById('boe-val-peak-write-qps')?.textContent || '';
        const readQps = document.getElementById('boe-val-avg-read-qps')?.textContent || '';
        const peakRead = document.getElementById('boe-val-peak-read-qps')?.textContent || '';
        const dataDay = document.getElementById('boe-val-data-day')?.textContent || '';
        const dataYear = document.getElementById('boe-val-data-year')?.textContent || '';
        const dataRepl = document.getElementById('boe-val-data-replicated')?.textContent || '';
        const ingress = document.getElementById('boe-val-ingress')?.textContent || '';
        const egress = document.getElementById('boe-val-egress')?.textContent || '';
        const cache = document.getElementById('boe-val-cache')?.textContent || '';

        const md = [
          `### Back-of-the-Envelope Capacity Estimate`,
          `**Inputs:** ${dau}M DAU | ${actions} writes/user/day | ${kb} KB payload | ${ratio}:1 Read/Write | ${repl}x Replication\n`,
          `| Category | Metric | Estimated Value |`,
          `| :--- | :--- | :--- |`,
          `| **Traffic** | Average Write QPS | \`${writeQps}\` |`,
          `| | Peak Write QPS (3x) | \`${peakWrite}\` |`,
          `| | Average Read QPS | \`${readQps}\` |`,
          `| | Peak Read QPS (3x) | \`${peakRead}\` |`,
          `| **Storage** | Daily New Data | \`${dataDay}\` |`,
          `| | Annual New Data | \`${dataYear}\` |`,
          `| | Stored with ${repl}x Replication | \`${dataRepl}\` |`,
          `| **Bandwidth & Cache** | Ingress (Writes) | \`${ingress}\` |`,
          `| | Egress (Reads) | \`${egress}\` |`,
          `| | 80/20 Hot Set Cache | \`${cache}\` |`
        ].join('\n');

        const mdTextEl = document.getElementById('boe-md-text');
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(md);
          } else {
            window.prompt('Copy markdown summary:', md);
          }
          if (mdTextEl) {
            const prev = mdTextEl.textContent;
            mdTextEl.textContent = 'Copied to clipboard!';
            setTimeout(() => { mdTextEl.textContent = prev; }, 2000);
          }
        } catch {
          window.prompt('Copy markdown summary:', md);
        }
      });

      resetBtn?.addEventListener('click', () => {
        dauEl.value = '10';
        actionsEl.value = '5';
        payloadEl.value = '2';
        ratioEl.value = '100';
        replEl.value = '3';
        calculate();
        const url = new URL(window.location.href);
        url.search = '';
        window.history.replaceState({}, '', url.toString());
      });

      calculate();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBoeCalculator);
    } else {
      initBoeCalculator();
    }
    document.addEventListener('astro:page-load', initBoeCalculator);
  })();
</script>
